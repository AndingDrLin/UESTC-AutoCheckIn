# ---------------------------------------------------------------------------
# 复制为 .env 后修改。Docker Compose 会自动读取同目录下的 .env。
# ---------------------------------------------------------------------------

# 【必改】管理后台密码。请使用长随机字符串，不要保留默认值。
ADMIN_PASSWORD=change-this-to-a-long-random-password

# 【建议】固定的加密/会话密钥。留空时首次启动会自动生成到 data/secret.key。
# 生成：python -c "import secrets; print(secrets.token_urlsafe(48))"
# 注意：更换 APP_SECRET 会导致已保存的用户密码无法解密。
APP_SECRET=

# 时区。中国大陆用户保持 Asia/Shanghai。
TZ=Asia/Shanghai

# 宿主机监听地址。只在本机访问用 127.0.0.1；局域网/公网访问改为 0.0.0.0。
APP_BIND=127.0.0.1
APP_PORT=8000

# 个人自动签到的随机窗口（平台时段 21:00–23:30）；新账号需单独开启个人自动签到。
CHECKIN_WINDOW_START=21:30
CHECKIN_WINDOW_END=23:00

# 个人签到失败重试：基准间隔（秒）、窗口内最大尝试次数。情况上报写结果不明不盲目重发。
RETRY_INTERVAL_SEC=180
MAX_ATTEMPTS=20

# 多账号个人签到计划的最小提交间隔（秒），避免同时请求。
MIN_USER_GAP_SEC=30

# 登录保护：两次登录最小间隔（秒）、每天最多登录次数。
LOGIN_COOLDOWN_SEC=600
MAX_LOGINS_PER_DAY=3

# 单次学校接口请求超时（秒）。
HTTP_TIMEOUT=20

# 后台调度总开关：控制个人自动签到及定时情况上报；关闭后仍可手动操作和预览。
SCHEDULER_ENABLED=true

# 提交前是否调用学校逆地理编码接口。关闭时使用用户地址或默认地址。
REVERSE_GEOCODE=false

# 仅在 HTTPS 反向代理后开启，否则浏览器不会回传登录 Cookie。
COOKIE_SECURE=false

# 全局通知 Webhook（可选）。支持 ServerChan（sctapi.ftqq.com/....send）
# 或任意接收 JSON POST 的地址。用户级通知地址会覆盖此项。
NOTIFY_WEBHOOK=

# DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
