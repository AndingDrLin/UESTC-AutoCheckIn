# Normalize text files to LF in the repository, regardless of the OS.
* text=auto eol=lf

# Windows-only scripts keep CRLF if any are added later.
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# Binary assets
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
